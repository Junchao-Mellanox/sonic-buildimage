SAI_INIT_CONFIG_FILE=/usr/share/sonic/hwsku/sai_5600.xml
SAI_PROFILE_COUNTER_SNAPSHOT_MODE=COUNTER_SNAPSHOT_TRIGGER_MODE
SAI_COUNTER_SNAPSHOT_CONFIG_FILE=/usr/share/sonic/hwsku/counter.conf
SAI_PER_PORT_IP_COUNTER_ENABLED=1
SAI_KEY_AR_CLASSIFIER_AUTO_ENABLED=0
SAI_KEY_PSAMPLE_TYPE_SLOW_PATH_ON_EGRESS_ENABLED=1
SAI_KEY_PSAMPLE_GROUP_ID_FOR_EGRESS=2
SAI_KEY_SOFT_RATE_LIMIT_ENABLED=1
SAI_KEY_ASIC_RLIMIT_CONFIDENCE_INTERVAL=6
SAI_KEY_MIRROR_PACKET_TO_TWO_NETDEVICES_ON_CPU=1
SAI_ASYNC_ROUTING_ENABLED=1
SAI_DEFAULT_SWITCHING_MODE_STORE_FORWARD=1
SAI_KEY_PFC_WD_FORWARD_ACTION_BEHAVIOR=PFC_WD_FORWARD_ACTION_NORMAL_RECOVERY
SAI_KEY_USE_FIXED_PORT_MIRROR_LABEL=1
SAI_KEY_BUFFER_POOL_CALCULATION_ENABLED=1
SAI_KEY_DISABLE_PORT_ALPHA=1
SAI_ADAPTIVE_ROUTING_CIRCULATION_PORT=257
SAI_MIRROR_SESSION_HW_ID_RESERVATION=7
SAI_KEY_BUFFER_STAT_OCCUPANCY_BYTES_CONTAIN_HEADROOM=1
SAI_TRAP_GROUP_POLICER_STATS_COLOR_PACKETS_ENABLED=1
SAI_KEY_HOSTIF_V2_ENABLED=1
SAI_KEY_CPU_PORT_EGRESS_QUEUES_NUM=32
SAI_HOSTIF_OPER_STATUS_UPDATE_BY_APP=1
SAI_KEY_EGRESS_POOL_ENABLE_INFINITE_SIZE=1
SAI_AGGREGATE_INGRESS_PIPELINE_DROPS=1
SAI_AGGREGATE_EGRESS_PIPELINE_DROPS=1
SAI_KEY_PACKET_TRAP_ACTION=TRAP_2_CPU
SAI_KEY_PORT_LINK_UP_EVENT_DELAY=50
SAI_KEY_REPORT_QUEUE_TYPE_AS_ALL=1
SAI_PIPELINE_LATENCY_SIZE=65536
